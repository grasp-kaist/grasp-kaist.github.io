PORT=3000
DATABASE_PATH=./data/sandbox/grasp-profile-bot.sqlite
PROFILE_PUBLISH_MODE=sandbox
SANDBOX_PROFILE_DIRECTORY=./data/sandbox-profiles
PROFILE_BACKUP_DIRECTORY=./data/backups
PROFILE_BACKUP_INTERVAL_MS=21600000
PROFILE_BACKUP_RETENTION_COUNT=28

# Railway provides this automatically when a volume is attached. Do not set it manually.
RAILWAY_VOLUME_MOUNT_PATH=
# The production container sets this to true and refuses ephemeral storage.
PROFILE_REQUIRE_PERSISTENT_STORAGE=false
# Generate one UUID for this volume and keep it unchanged.
PROFILE_STORAGE_ID=
# One-time volume initialization only. Remove both flags before normal startup.
PROFILE_INITIALIZE_STORAGE=false
PROFILE_ADOPT_EXISTING_STORAGE=false

DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=

# Required only when PROFILE_PUBLISH_MODE=production.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_OWNER=grasp-kaist
GITHUB_REPO=grasp-kaist.github.io
GITHUB_DEFAULT_BRANCH=main
GITHUB_VALIDATE_WORKFLOW=validate-profile-bot.yml
GITHUB_DEPLOY_WORKFLOW=deploy.yml

# Used only in production mode.
MEMBERS_PAGE_URL=https://grasp-kaist.github.io/members/
